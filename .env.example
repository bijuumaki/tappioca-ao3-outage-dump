NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comment alert emails (Resend). With any of these missing, comments still post; no email is sent.
RESEND_API_KEY=
RESEND_FROM=
ALERT_EMAIL=
# Optional: the public address used in alert links (default https://tappiocarchive.vercel.app)
SITE_URL=
# Optional: extra secret mixed into the stored sender hash (default: the Supabase secret key)
COMMENT_HASH_SALT=
# Needed for admin tests (Plan 2a): never commit real values
E2E_ADMIN_PASSWORD=
